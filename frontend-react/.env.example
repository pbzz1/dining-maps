# Kakao Maps JavaScript key (developers.kakao.com -> 앱 키 -> JavaScript 키).
# Vite only exposes vars prefixed with VITE_ to the browser.
VITE_KAKAO_JS_KEY=

# Empty in dev: requests go to /api/* and the Vite proxy forwards them to
# FastAPI (see vite.config.js). Set this to the deployed API origin for a
# production build.
VITE_API_BASE=

# --- 검색 등록·수익화 (전부 선택, 비워 두면 해당 요소만 빠진다) ---
# 검색엔진 소유 확인 메타의 content 값. 서치콘솔은 "URL 접두어" 속성 -> HTML 태그,
# 네이버 서치어드바이저는 사이트 등록 -> HTML 태그. 빌드 후처리가 모든 페이지 <head>에 넣는다.
VITE_GOOGLE_SITE_VERIFICATION=
VITE_NAVER_SITE_VERIFICATION=
# 있으면 /data/ (데이터셋 안내 + 샘플 CSV + 문의 메일) 페이지를 만든다. 공개 페이지에 그대로 노출된다.
VITE_CONTACT_EMAIL=
# 후원 링크(토스 송금 링크 등). About 화면과 정적 페이지 푸터에 나온다.
VITE_DONATE_URL=
# 애드센스. *.cloudfront.net 은 승인이 안 나므로 커스텀 도메인을 붙인 뒤에만 채운다.
# CLIENT 만 있으면 자동 광고 스크립트 + ads.txt, SLOT 까지 있으면 고정 광고 단위도 그린다.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT=
# 쿠팡 파트너스 링크는 환경변수가 아니라 src/affiliate.json 에 직접 붙여 넣는다.
# 토스페이먼츠 클라이언트 키(선택). 서버가 TOSS_CLIENT_KEY 를 /api/billing/me 로 내려 주면 비워 둬도 된다.
# 둘 다 있으면 서버 값이 우선 -- 시크릿 키와 같은 상점의 짝이어야 하기 때문.
VITE_TOSS_CLIENT_KEY=

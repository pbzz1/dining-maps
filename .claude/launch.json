{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "static-dist",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4173",
        "--directory",
        "frontend-react/dist"
      ],
      "port": 4173
    },
    {
      "name": "api",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "vite",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frontend-react"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "api-worktree",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--port",
        "8001"
      ],
      "port": 8001
    },
    {
      "name": "vite-worktree",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frontend-react"
      ],
      "port": 5173,
      "env": {
        "API_PORT": "8001"
      },
      "autoPort": true
    },
    {
      "name": "vite-lambda",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frontend-react"
      ],
      "port": 5173,
      "env": {
        "VITE_API_BASE": "https://npedx3ncoyh2q6r6sdnnti2hni0ammuk.lambda-url.ap-southeast-2.on.aws"
      },
      "autoPort": true
    }
  ]
}
# 백엔드·파이프라인 환경변수. 이 파일을 .env 로 복사해 채운다 (.env 는 커밋되지 않는다).
# 이미 설정된 진짜 환경변수가 있으면 그쪽이 우선한다 (app/env.py).
# 프론트엔드 변수는 frontend-react/.env.example 을 따로 본다.

# PostgreSQL 접속 문자열. 로컬 도커는 postgresql://dining:dining@localhost:5432/dining_maps,
# Neon 등 관리형 DB는 콘솔에서 준 문자열을 그대로 넣는다 (?sslmode=require 포함).
DATABASE_URL=

# 로그인(선택). 없으면 /api/auth/status 가 enabled:false 를 주고 로그인 버튼이 그려지지 않는다.
JWT_SECRET=
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=
FRONTEND_URL=
# 카카오 앱 보안 설정을 켠 경우에만 필요.
KAKAO_CLIENT_SECRET=

# LLM(선택). 없으면 LLM 배치는 조용히 스킵되고, 유료 추천·대화는 무료 방식으로 대체된다.
ANTHROPIC_API_KEY=

# 토스페이먼츠(선택). 없으면 /api/billing/checkout 이 503 이고 요금제 페이지의 결제 버튼이 비활성화된다.
# 테스트 키(test_sk_ / test_ck_)로 실결제 없이 끝까지 검증할 수 있다. 라이브 키는 사업자등록·토스 계약 뒤.
# 클라이언트 키는 공개 키라 /api/billing/me 로 프론트에 내려 준다(프론트 빌드 변수 없이 짝을 한 곳에서 맞춘다).
TOSS_SECRET_KEY=
TOSS_CLIENT_KEY=
